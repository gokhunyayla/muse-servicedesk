# Muse ServiceDesk — local configuration.
# API keys and tokens are NOT set here: admins enter them in the console (Settings → Models / Channels),
# where they are stored encrypted. This file only holds infrastructure settings.

# Database. Default: local MariaDB (root, empty password); the database is created on start.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/muse_servicedesk

# HTTP port of the console / API, and the interface to bind (127.0.0.1 behind a reverse proxy)
PORT=1002
HOST=0.0.0.0

# Public URL of this console (used in invitation and password-reset links)
PUBLIC_URL=http://localhost:1002

# Desk time zone for Today/Week/… filters, SLA and report schedules
DESK_TZ=UTC          # IANA zone for reports and dashboards, e.g. Europe/London

# Meta Model API endpoint and model names (keys are entered in the console)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_MODEL_HEAVY=muse-wonder-1.0
META_REASONING_EFFORT=low
