# Meta Model API (https://dev.meta.ai). The key is normally entered in the console (Settings → Models);
# this is only a fallback for first run.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_MODEL_HEAVY=muse-wonder-1.0
META_REASONING_EFFORT=low

# Database. Default: local MariaDB (root, empty password); the database is created on start.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/muse_servicedesk

PORT=1002

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup). Webhook: https://<public-url>/webhook
WA_VERIFY_TOKEN=muse-servicedesk
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Demo only: route manager approval requests (E1002/E1003) to a real WhatsApp number
DEMO_MANAGER_PHONE=

# Console sign-in: no admin credentials here — the first admin is created at /setup on first run.
PUBLIC_URL=http://localhost:1002
# Password-reset e-mails (optional). Without SMTP the reset link is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Integration API (/messages, /voice, /image, /video, /camera, /approvals, /outbound, …).
# When set, callers must send X-API-Key. Leave empty for local development. The WhatsApp webhook is always open.
API_KEY=

# Desk time zone for Today/Week/... filters
DESK_TZ=Europe/Istanbul

# Supervisor web research (optional). Leave empty to use DuckDuckGo without a key.
TAVILY_API_KEY=
