# Meta Model API (https://dev.meta.ai)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_MODEL_HEAVY=muse-wonder-1.0
META_REASONING_EFFORT=low

# Database. Default: local MariaDB (root, empty password); the database is created on start.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/muse_servicedesk

PORT=1002

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup). Webhook: https://<public-url>/webhook
WA_VERIFY_TOKEN=muse-servicedesk
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Demo only: route manager approval requests (E1002/E1003) to a real WhatsApp number
DEMO_MANAGER_PHONE=
